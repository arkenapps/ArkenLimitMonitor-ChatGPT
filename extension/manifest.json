{
  "manifest_version": 3,
  "name": "Arken Limit Monitor — Usage Meter for ChatGPT",
  "short_name": "Arken Limit Monitor",
  "version": "1.1.0",
  "description": "Unofficial. Not affiliated with OpenAI. Shows your ChatGPT/Codex usage limits, resets and usage credits locally in your browser.",
  "author": "ArkenApps",
  "homepage_url": "https://arkenapps.com/arken-limit-monitor.html",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "usage-parser.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Arken Limit Monitor — show/hide (unofficial)"
  }
}
